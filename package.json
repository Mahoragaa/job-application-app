{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:check": "node scripts/check-account.mjs",
    "db:reset-auth": "node scripts/reset-auth.mjs",
    "db:reset-data": "node scripts/reset-data.mjs",
    "db:backfill": "tsx scripts/backfill-company-key.ts",
    "typecheck": "tsc --noEmit",
    "autopush:now": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auto-push.ps1",
    "autopush:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-auto-push.ps1",
    "autopush:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-auto-push.ps1 -Uninstall",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.25",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
