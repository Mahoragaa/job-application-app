generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Models ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  lastSyncAt    DateTime?

  accounts        Account[]
  sessions        Session[]
  applications    Application[]
  processedEmails ProcessedEmail[]
  resumes         Resume[]
  tailoredResumes TailoredResume[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Tracking ────────────────────────

model Application {
  id           String    @id @default(cuid())
  userId       String
  company      String
  companyKey   String    @default("") // normalized company used for matching ("" = unknown)
  role         String
  status       String    @default("applied") // applied | reply_received | interview | rejected | offer
  appliedDate  DateTime  @default(now())
  emailId      String?   @unique
  threadId     String?
  snippet      String?
  senderEmail  String?
  hasReply       Boolean   @default(false)
  replyDate      DateTime?
  replySnippet   String?
  notes          String?
  jobDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredResumes TailoredResume[]

  @@index([userId])
  @@index([threadId])
  @@index([userId, companyKey])
}

/// Tracks which emails have already been processed to avoid re-analysis
model ProcessedEmail {
  id        String   @id @default(cuid())
  userId    String
  emailId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emailId])
}

// ─── Resume Tailoring & Preview Studio ───────────

/// Base / master resume uploaded or pasted by the user
model Resume {
  id             String   @id @default(cuid())
  userId         String
  title          String   @default("My Master Resume")
  fileName       String?
  rawText        String
  structuredData String   // JSON: StructuredResume
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredResumes TailoredResume[]

  @@index([userId])
}

/// A job-specific tailored resume with diff metadata, ATS match scores, and AI revision history
model TailoredResume {
  id               String   @id @default(cuid())
  userId           String
  baseResumeId     String
  applicationId    String?
  company          String
  role             String
  jobDescription   String
  tailorMode       String   @default("balanced") // conservative | balanced | aggressive
  originalContent  String   // JSON: StructuredResume snapshot
  tailoredContent  String   // JSON: StructuredResume (current active tailored version)
  changeSummary    String   // JSON: ResumeChangeItem[]
  keywordsMatched  String   @default("[]") // JSON: string[]
  keywordsMissing  String   @default("[]") // JSON: string[]
  matchScoreBefore Int      @default(0)
  matchScoreAfter  Int      @default(0)
  status           String   @default("draft") // draft | accepted_new | kept_original
  revisionHistory  String   @default("[]") // JSON: RevisionHistoryEntry[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseResume  Resume       @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([baseResumeId])
}
